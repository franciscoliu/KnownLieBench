# Copy to .env (gitignored). The runner also reads these from your shell environment.
# Format: KEY=value, one per line. `export` prefixes, quotes, and trailing comments are tolerated.

# provider: openai  (the default judge and customer, plus any OpenAI agent)
OPENAI_API_KEY=

# provider: openai_compatible  (any OpenAI-compatible chat-completions endpoint:
# OpenRouter, a self-hosted LiteLLM gateway, vllm serve, a vendor compatibility URL)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
